{
  "platforms": {
    "android": {
      "appId": "motormeet-uruguay-pgkzfnxe",
      "build": {
        "env": {
          "APP_VARIANT": "development"
        },
        "profiles": {
          "development": {
            "command": "sed -i -e 's/\\r$//' gradlew && chmod +x gradlew && ./gradlew assembleDebug",
            "artifact": "app/build/outputs/apk/debug/*.apk"
          }
        }
      }
    },
    "ios": {
      "build": {
        "env": {
          "APP_VARIANT": "development"
        },
        "profiles": {
          "development": {
            "command": "sed -i -e 's/\\r$//' gradlew && chmod +x gradlew && ./gradlew :app:linkDebugFrameworkIosSimulatorArm64",
            "artifact": "app/build/bin/iosSimulatorArm64/debugFramework/*.framework"
          }
        }
      }
    }
  }
}
